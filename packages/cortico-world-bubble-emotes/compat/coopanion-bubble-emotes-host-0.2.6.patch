index 0000000..613dc57
--- /dev/null
+++ b/packages/cortico-world-desktop-pet/src/expression-preference.ts
@@ -0,0 +1,27 @@
+import {TOUCH_KINDS} from './config.ts';
+
+export interface ExpressionPreference {
+  wakeOn: 'none'|'poke'|'all'|'custom'|null;
+  wakeKinds: string[];
+  style: 'restrained'|'natural'|'lively';
+  reason: 'habit_quiet'|'habit_default'|'habit_active'|'custom_touch'|'custom_deferred'|'custom_non_touch'|'habit_state_unavailable';
+}
+/** A reply-style hint only; never schedules a reply or authorizes a physical wake. */
+export function expressionPreference(touch: {wakeOn?:unknown;wakeKinds?:unknown}, event?:{kind?:unknown;immediate?:boolean}):ExpressionPreference {
+  const raw=touch?.wakeOn;
+  const wakeOn=raw==='none'||raw==='poke'||raw==='all'||raw==='custom'?raw:null;
+  const rawKinds=touch?.wakeKinds;
+  const wakeKinds:string[]=Array.isArray(rawKinds)?TOUCH_KINDS.filter(k=>rawKinds.includes(k)):[];
+  if(wakeOn==='none')return {wakeOn,wakeKinds,style:'restrained',reason:'habit_quiet'};
+  if(wakeOn==='all')return {wakeOn,wakeKinds,style:'lively',reason:'habit_active'};
+  if(wakeOn==='custom') {
+    const touchEvent=typeof event?.kind==='string'&&(TOUCH_KINDS as readonly string[]).includes(event.kind);
+    const selected=touchEvent&&wakeKinds.includes(event!.kind as string)&&event?.immediate===true;
+    return {wakeOn,wakeKinds,style:touchEvent?(selected?'lively':'restrained'):'natural',reason:touchEvent?(selected?'custom_touch':'custom_deferred'):'custom_non_touch'};
+  }
+  return {wakeOn,wakeKinds,style:'natural',reason:wakeOn===null?'habit_state_unavailable':'habit_default'};
+}
+export function expressionInstruction(p:ExpressionPreference):string {
+  const preference=p.style==='restrained'?'Prefer text; use one emote when explicitly requested or emotionally useful.':p.style==='lively'?'Actively consider one fitting emote in friendly, grateful, comforting or emotional replies.':'Naturally include one fitting emote for greetings, gratitude, comfort, thought or shared feelings; factual replies may use none.';
+  return `Expression preference: ${p.style}; Habits response mode: ${p.wakeOn??'unknown'}; custom touches: ${p.wakeKinds.join(',')||'none'}. ${preference} This is a hint for a reply already warranted; it never triggers extra replies or grants physical wake permission. Respect context, negation, quotation, body state and reviewed/disabled assets. For a familiar Unicode emoji, call pet_say once with script, emoji and expression (or presentation for advanced mixing); search/prepare is optional for basic emoji, required when selecting custom sticker attachments. Keep text-only responses when that fits better. A plain script or textual description does not by itself display an emote.`;
+}
