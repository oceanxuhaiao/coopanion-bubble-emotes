+import {describe,it,expect} from 'vitest';
+import {expressionPreference,expressionInstruction} from '../src/expression-preference.ts';
+describe('expression style follows Habits without changing wake rules',()=>{
+ it.each([['none','restrained'],['poke','natural'],['all','lively'],['unknown','natural']])('%s maps to %s', (wakeOn,style)=>expect(expressionPreference({wakeOn}).style).toBe(style));
+ it.each(['poke','pet','throw','drop'])('custom honors checked %s only for immediate authorized touch',kind=>{
+   expect(expressionPreference({wakeOn:'custom',wakeKinds:[kind]},{kind,immediate:true}).style).toBe('lively');
+   expect(expressionPreference({wakeOn:'custom',wakeKinds:[kind]},{kind,immediate:false}).style).toBe('restrained');
+   expect(expressionPreference({wakeOn:'custom',wakeKinds:[]},{kind,immediate:true}).style).toBe('restrained');
+ });
+ it('custom chat and mixed unknown sources are natural regardless of checked count',()=>{
+   for(const wakeKinds of [[],['poke'],['poke','pet','throw','drop']])for(const event of [undefined,{kind:'unknown',immediate:true}])expect(expressionPreference({wakeOn:'custom',wakeKinds},event).style).toBe('natural');
+ });
+ it('unknown state is an explicit natural fallback, never wake permission',()=>{
+   const p=expressionPreference({wakeOn:null,wakeKinds:'broken'});expect(p).toMatchObject({style:'natural',reason:'habit_state_unavailable',wakeKinds:[]});expect(expressionInstruction(p)).toContain('never triggers extra replies or grants physical wake permission');
+ });
+});
