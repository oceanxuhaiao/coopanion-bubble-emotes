index 0000000..f922fa3
--- /dev/null
+++ b/packages/cortico-world-desktop-pet/web/presentation.js
@@ -0,0 +1,98 @@
+/** Structured bubble content and its speech-only projection. No DOM content becomes TTS input. */
+const graphemes = new Intl.Segmenter(undefined, { granularity: 'grapheme' });
+const pictograph = /\p{Extended_Pictographic}|\p{Regional_Indicator}|\u20e3|\ufe0f/u;
+const plainEmoji = /\p{Emoji_Presentation}/u;
+export const splitGraphemes = (text) => [...graphemes.segment(text)].map((s) => s.segment);
+export const isEmoji = (text) => plainEmoji.test(text) || (pictograph.test(text) && /\ufe0f|\u200d|\u20e3/u.test(text));
+export function speechText(text) {
+  return splitGraphemes(text).map((s) => isEmoji(s) ? ' ' : s)
+    .join('').replace(/[ \t]+/g, ' ').replace(/ +([，。！？、,.!?;:；：])/g, '$1').trim();
+}
+export function presentationSpeech(segments) {
+  return speechText(segments.map((s) => s.kind === 'text' ? s.text : ' ').join(''));
+}
+
+/** Text offsets map back to the original string, keeping speech reveal timing correct around emoji. */
+export function speechProjection(text) {
+  let spoken = '', offset = 0;
+  const ends = [];
+  for (const g of splitGraphemes(text)) {
+    const start = offset;
+    offset += g.length;
+    if (isEmoji(g)) continue;
+    spoken += g;
+    for (let i = start; i < offset; i++) ends.push(i + 1);
+  }
+  return { text: spoken, ends };
+}
+
+export function renderPresentation(root, segments, visible = Infinity) {
+  const doc = root.ownerDocument, nodes = [];
+  let remaining = visible;
+  for (const s of segments) {
+    if (s.kind === 'text') {
+      const letters = splitGraphemes(s.text);
+      nodes.push(doc.createTextNode(letters.slice(0, Math.max(0, remaining)).join('')));
+      remaining -= letters.length;
+    } else {
+      if (remaining <= 0) break;
+      if (s.kind === 'emoji') {
+        const span = doc.createElement('span');
+        span.className = 'b-emoji'; span.textContent = s.text;
+        nodes.push(span);
+      } else {
+        const img = doc.createElement('img');
+        img.className = 'b-sticker'; img.src = s.src; img.alt = s.alt;
+        img.width = s.width; img.height = s.height;
+        nodes.push(img);
+      }
+      remaining--;
+    }
+    if (remaining <= 0) break;
+  }
+  root.replaceChildren(...nodes);
+}
+export const presentationLength = (segments) => segments.reduce((n, s) => n + (s.kind === 'text' ? splitGraphemes(s.text).length : 1), 0);
+
+/** A command is accepted only after a subsequent body frame reports the target face and sequence. */
+export class PresentationSession {
+  constructor(plan, { command, finish, now = () => performance.now() }) {
+    Object.assign(this, { plan, command, finish, now });
+    this.phase = 'loading'; this.at = now(); this.index = 0; this.seq = 0;
+  }
+  loaded() { if (this.phase === 'loading') { this.phase = 'transition'; this.at = this.now(); } }
+  cancel(reason) {
+    if (this.phase === 'closed') return;
+    this.phase = 'closed'; this.finish(reason);
+  }
+  step(state, figure) {
+    if (this.phase === 'closed') return false;
+    const cue = this.plan.bodyCue;
+    if (figure !== this.plan.figure) { this.cancel('figure-changed'); return false; }
+    if (!state || state.face === null) { this.cancel('state-unknown'); return false; }
+    if (state.busy || state.pressing || ['drag', 'air', 'crouch', 'dizzy'].includes(state.mode)) {
+      this.cancel('body-interrupted'); return false;
+    }
+    if ((state.mode === 'sleep' || (state.face === 'sleepy' && cue.expression !== 'sleepy')) && !cue.allowWake) { this.cancel('sleeping'); return false; }
+    if (this.phase === 'loading') return false;
+    if (this.phase === 'showing') {
+      if (state.face !== cue.expression || state.gesture !== null || !['idle', 'sit'].includes(state.mode)) {
+        this.cancel('body-changed'); return false;
+      }
+      return true;
+    }
+    if (this.now() - this.at > 8000) { this.cancel('transition-timeout'); return false; }
+    const steps = this.steps ??= [
+      ...(!['idle', 'sit'].includes(state.mode) && this.plan.canStand && !cue.transitions.includes('stand') ? ['stand'] : []),
+      ...cue.transitions, cue.expression,
+    ];
+    if (this.seq && (state.commandSeq < this.seq || state.mode === 'wake' || state.gesture !== null)) return false;
+    if (this.index < steps.length) {
+      this.seq = this.command(steps[this.index++]);
+      return false;
+    }
+    if (state.face !== cue.expression || !['idle', 'sit'].includes(state.mode)) return false;
+    this.phase = 'showing';
+    return true;
+  }
+}
