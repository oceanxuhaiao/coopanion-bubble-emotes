+  it('resolves attachment handles, bounds media, projects speech and validates actions',()=>{
+    const raw={schema:1,requestId:'r1',figure:'coo',expectedStateRevision:1,bodyCue:{expression:'happy',transitions:['stand'],allowWake:false},segments:[{kind:'text',text:'你好😊'},{kind:'sticker',handle:'log:one',alt:'hug'},{kind:'text',text:''}]};
