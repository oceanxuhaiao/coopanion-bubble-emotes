{
  "name": "cortico-world-bubble-emotes",
  "version": "0.3.0",
  "type": "module",
  "description": "原版 Coopanion 0.2.8 普通emoji表情库：安装启用即可使用，无需主程序补丁；不含图片、表情包发送或自定义气泡渲染。",
  "license": "AGPL-3.0-or-later",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "emoji",
    "emotes",
    "表情",
    "表情包",
    "桌宠",
    "气泡"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "表情库 · Emoji",
    "webUiClient": "dist/webui.js",
    "tags": [
      "experimental"
    ],
    "locales": {
      "zh": {
        "displayName": "表情库 · Emoji",
        "description": "原版 Coopanion 0.2.8 普通emoji表情库：安装启用即可使用，无需主程序补丁；不含图片、表情包发送或自定义气泡渲染。"
      },
      "en": {
        "displayName": "Emoji Library",
        "description": "Unicode emoji meanings for stock Coopanion 0.2.8. No host patches, image sending, sticker rendering or rich-bubble hooks."
      }
    }
  },
  "files": [
    "src/catalog.ts",
    "src/config.ts",
    "src/definition.ts",
    "src/emoji.ts",
    "src/index.ts",
    "src/library.ts",
    "src/world.ts",
    "src/ENV_PROMPT.md",
    "dist/webui.js",
    "describe.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm --prefix ../.. test -- packages/cortico-world-bubble-emotes/tests",
    "typecheck": "tsc --noEmit",
    "build": "esbuild web/client.ts --bundle --format=esm --outfile=dist/webui.js"
  },
  "devDependencies": {
    "cortico": "^0.2.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanxuhaiao/coopanion-bubble-emotes.git",
    "directory": "packages/cortico-world-bubble-emotes"
  },
  "homepage": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes#readme",
  "bugs": {
    "url": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes/issues"
  },
  "author": "oceanxuhaiao",
  "publishConfig": {
    "access": "public"
  }
}
