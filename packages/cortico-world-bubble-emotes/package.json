{
  "name": "cortico-world-bubble-emotes",
  "version": "0.4.0",
  "type": "module",
  "description": "37个emoji搭配可编辑情绪与身体心情映射。由桌宠当前主模型提交草稿自检，无需额外API配置；不采集发言、不保存草稿，不自动安排动作。",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "emoji",
    "emotes",
    "表情",
    "桌宠",
    "气泡",
    "情绪",
    "表达助手",
    "身体心情"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "表达助手 · 情绪与表情",
    "webUiClient": "dist/webui.js",
    "tags": [
      "experimental",
      "high-cost"
    ],
    "locales": {
      "zh": {
        "displayName": "表达助手 · 情绪与表情",
        "description": "37个emoji搭配可编辑情绪与身体心情映射。由桌宠当前主模型提交草稿自检，无需额外API配置；不采集发言、不保存草稿，不自动安排动作。"
      },
      "en": {
        "displayName": "表达助手 · 情绪与表情",
        "description": "37 emoji with editable emotion and body-expression mappings. Validates the current model draft self-check without collecting speech, storing drafts or requiring a separate API."
      }
    },
    "icon": "assets/icon.svg"
  },
  "files": [
    "dist/index.js",
    "dist/ENV_PROMPT.md",
    "dist/webui.js",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "assets/icon.svg"
  ],
  "scripts": {
    "test": "npm --prefix ../.. test -- packages/cortico-world-bubble-emotes/tests",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "cortico": "^0.2.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanxuhaiao/coopanion-bubble-emotes.git",
    "directory": "packages/cortico-world-bubble-emotes"
  },
  "homepage": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes#readme",
  "bugs": {
    "url": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes/issues"
  },
  "author": "oceanxuhaiao",
  "publishConfig": {
    "access": "public"
  }
}
