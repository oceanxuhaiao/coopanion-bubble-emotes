{
  "name": "cortico-world-bubble-emotes",
  "version": "0.3.2",
  "type": "module",
  "description": "让桌宠的问候带上笑意，也让安慰多一点温度。37 个 emoji 与语境提示，把开心、思考和陪伴写进气泡。原版 Coopanion 0.2.8 安装启用即可，无需修改主程序。",
  "license": "AGPL-3.0-or-later",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "emoji",
    "emotes",
    "表情",
    "桌宠",
    "气泡"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "表情",
    "webUiClient": "dist/webui.js",
    "tags": [
      "experimental",
      "high-cost"
    ],
    "locales": {
      "zh": {
        "displayName": "表情",
        "description": "让桌宠的问候带上笑意，也让安慰多一点温度。37 个 emoji 与语境提示，把开心、思考和陪伴写进气泡。原版 Coopanion 0.2.8 安装启用即可，无需修改主程序。"
      },
      "en": {
        "displayName": "表情",
        "description": "A little smile in a greeting, a little warmth in a quiet moment. Give your pet 37 emoji and contextual hints for joy, thought and companionship. Works with stock Coopanion 0.2.8; no host patch required."
      }
    },
    "icon": "assets/icon.svg"
  },
  "files": [
    "src/catalog.ts",
    "src/config.ts",
    "src/definition.ts",
    "src/emoji.ts",
    "src/index.ts",
    "src/library.ts",
    "src/world.ts",
    "src/ENV_PROMPT.md",
    "dist/webui.js",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "assets/icon.svg",
    "src/usage-fallback.ts",
    "src/expression-log.ts",
    "src/cloud-settings.ts",
    "src/analysis-response.ts"
  ],
  "scripts": {
    "test": "npm --prefix ../.. test -- packages/cortico-world-bubble-emotes/tests",
    "typecheck": "tsc --noEmit",
    "build": "esbuild web/client.ts --bundle --format=esm --outfile=dist/webui.js"
  },
  "devDependencies": {
    "cortico": "^0.2.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanxuhaiao/coopanion-bubble-emotes.git",
    "directory": "packages/cortico-world-bubble-emotes"
  },
  "homepage": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes#readme",
  "bugs": {
    "url": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes/issues"
  },
  "author": "oceanxuhaiao",
  "publishConfig": {
    "access": "public"
  }
}
