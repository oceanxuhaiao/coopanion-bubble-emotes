{
  "name": "cortico-world-bubble-emotes",
  "version": "0.3.6",
  "type": "module",
  "description": "让开心有笑意，安慰有温度。37个emoji搭配情绪分析与草稿检查，新增可编辑的“情绪→表情→身体心情”映射和身体心情建议；不自动安排动作，减少对睡眠与互动的干扰。分析需配置模型。",
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "emoji",
    "emotes",
    "表情",
    "桌宠",
    "气泡",
    "情绪",
    "表达助手",
    "身体心情"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "表达助手 · 情绪与表情",
    "webUiClient": "dist/webui.js",
    "tags": [
      "experimental",
      "high-cost"
    ],
    "locales": {
      "zh": {
        "displayName": "表达助手 · 情绪与表情",
        "description": "让开心有笑意，安慰有温度。37个emoji搭配情绪分析与草稿检查，新增可编辑的“情绪→表情→身体心情”映射和身体心情建议；不自动安排动作，减少对睡眠与互动的干扰。分析需配置模型。"
      },
      "en": {
        "displayName": "表达助手 · 情绪与表情",
        "description": "Help your pet express joy, comfort and thought with 37 emoji, emotion analysis, draft review and editable body-expression mappings. Analysis requires a configured model."
      }
    },
    "icon": "assets/icon.svg"
  },
  "files": [
    "dist/index.js",
    "dist/ENV_PROMPT.md",
    "dist/webui.js",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "assets/icon.svg"
  ],
  "scripts": {
    "test": "npm --prefix ../.. test -- packages/cortico-world-bubble-emotes/tests",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "cortico": "^0.2.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanxuhaiao/coopanion-bubble-emotes.git",
    "directory": "packages/cortico-world-bubble-emotes"
  },
  "homepage": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes#readme",
  "bugs": {
    "url": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes/issues"
  },
  "author": "oceanxuhaiao",
  "publishConfig": {
    "access": "public"
  }
}
