{
  "name": "cortico-world-bubble-emotes",
  "version": "0.2.4",
  "type": "module",
  "description": "Coopanion 表情与表情包：37 个基础表情、PNG 表情包、语境含义与身体同步。已适配 0.2.8，头顶混排气泡需配套宿主补丁。",
  "license": "AGPL-3.0-or-later",
  "main": "./src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "cortico-world",
    "cortico",
    "coopanion",
    "emoji",
    "emotes",
    "sticker",
    "stickers",
    "表情",
    "表情包",
    "桌宠",
    "气泡"
  ],
  "os": [
    "win32"
  ],
  "cortico": {
    "kind": "world",
    "api": 6,
    "describe": "describe.json",
    "displayName": "表情与表情包 · Bubble Emotes",
    "webUiClient": "dist/webui.js",
    "tags": [
      "experimental",
      "requires-extension",
      "external-setup"
    ],
    "locales": {
      "zh": {
        "displayName": "表情与表情包 · Bubble Emotes",
        "description": "Coopanion 表情与表情包：37 个基础表情、PNG 表情包、语境含义与身体同步。已适配 0.2.8，头顶混排气泡需配套宿主补丁。"
      },
      "en": {
        "displayName": "Bubble Emotes · Emoji & Stickers",
        "description": "37 contextual emoji and PNG stickers with body synchronization. Adapted for Coopanion 0.2.8; rich head bubbles require the matching host patch."
      }
    }
  },
  "files": [
    "src",
    "dist",
    "describe.json",
    "README.md",
    "CHANGELOG.md",
    "compat"
  ],
  "scripts": {
    "test": "npm --prefix ../.. test -- packages/cortico-world-bubble-emotes/tests",
    "typecheck": "tsc --noEmit",
    "build": "esbuild web/client.ts --bundle --format=esm --outfile=dist/webui.js"
  },
  "devDependencies": {
    "cortico": "^0.2.5",
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "esbuild": "^0.28.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oceanxuhaiao/coopanion-bubble-emotes.git",
    "directory": "packages/cortico-world-bubble-emotes"
  },
  "homepage": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes#readme",
  "bugs": {
    "url": "https://github.com/oceanxuhaiao/coopanion-bubble-emotes/issues"
  },
  "author": "oceanxuhaiao",
  "publishConfig": {
    "access": "public"
  }
}
